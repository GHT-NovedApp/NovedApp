{
  "openapi": "3.0.3",
  "info": {
    "title": "NovedApp Web API",
    "version": "1.3.0-draft",
    "description": "Contrato propuesto del Web API (Azure App Service) para NovedApp. Generado a partir del comportamiento del v1 (PHP/JSON) y del SDD 001-novedapp. Base: /api/v1. Los errores usan application/problem+json. Autenticación con cuentas propias de NovedApp (decisión CL-001): el login devuelve un token bearer. Los adjuntos se guardan en Azure Blob Storage (CL-002). El envío de correos queda fuera de este contrato hasta que se conecte una API para esa función (CL-003)."
  },
  "servers": [
    { "url": "https://app-novedapp-api.azurewebsites.net/api/v1", "description": "Producción (nombre ilustrativo)" }
  ],
  "tags": [
    { "name": "Identidad" }, { "name": "Usuarios" }, { "name": "Organizaciones" },
    { "name": "Catálogos" }, { "name": "Tipos de novedad" }, { "name": "Novedades" },
    { "name": "Notificaciones" }, { "name": "Salud" }
  ],
  "security": [ { "bearerAuth": [] } ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Identidad"], "summary": "Iniciar sesión con la cuenta propia de NovedApp", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": {
          "200": { "description": "Sesión iniciada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SesionUsuario" } } } },
          "401": { "$ref": "#/components/responses/Problema" },
          "403": { "description": "Cuenta inactiva", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problema" } } } },
          "429": { "description": "Demasiados intentos" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Identidad"], "summary": "Usuario actual con permisos vigentes (se revalida en cada llamada)",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SesionUsuario" } } } }, "401": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/usuarios": {
      "get": {
        "tags": ["Usuarios"], "summary": "Listar usuarios (Parametrización)",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "permiso", "in": "query", "schema": { "$ref": "#/components/schemas/Permiso" } },
          { "name": "activo", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Usuario" } } } } }, "403": { "$ref": "#/components/responses/Problema" } }
      },
      "post": {
        "tags": ["Usuarios"], "summary": "Crear usuario",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioNuevo" } } } },
        "responses": { "201": { "description": "Creado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } } }, "400": { "$ref": "#/components/responses/Problema" }, "403": { "$ref": "#/components/responses/Problema" }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/usuarios/{usuario}": {
      "parameters": [ { "$ref": "#/components/parameters/UsuarioPath" } ],
      "put": {
        "tags": ["Usuarios"], "summary": "Editar usuario (el nombre de usuario no cambia si tiene historial)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioEdicion" } } } },
        "responses": { "200": { "description": "Actualizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } } }, "400": { "$ref": "#/components/responses/Problema" }, "403": { "$ref": "#/components/responses/Problema" }, "404": { "$ref": "#/components/responses/Problema" }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/usuarios/{usuario}/password": {
      "parameters": [ { "$ref": "#/components/parameters/UsuarioPath" } ],
      "post": {
        "tags": ["Usuarios"], "summary": "Restablecer contraseña (la política de contraseñas está pendiente de definir)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string", "minLength": 6, "maxLength": 72 } } } } } },
        "responses": { "204": { "description": "Actualizada" }, "400": { "$ref": "#/components/responses/Problema" }, "403": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/usuarios/{usuario}/estado": {
      "parameters": [ { "$ref": "#/components/parameters/UsuarioPath" } ],
      "post": {
        "tags": ["Usuarios"], "summary": "Activar o inactivar (alterna). No permite inactivar la propia cuenta ni al último administrador",
        "responses": { "200": { "description": "Estado nuevo", "content": { "application/json": { "schema": { "type": "object", "properties": { "activo": { "type": "boolean" } } } } } }, "403": { "$ref": "#/components/responses/Problema" }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/organizaciones": {
      "get": {
        "tags": ["Organizaciones"], "summary": "Listar organizaciones (paginado)",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "tipoActor", "in": "query", "schema": { "type": "string" } },
          { "name": "activo", "in": "query", "schema": { "type": "boolean" } },
          { "$ref": "#/components/parameters/Pagina" }, { "$ref": "#/components/parameters/TamanoPagina" }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaOrganizaciones" } } } } }
      },
      "post": {
        "tags": ["Organizaciones"], "summary": "Crear organización",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizacionEntrada" } } } },
        "responses": { "201": { "description": "Creada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Organizacion" } } } }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/organizaciones/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "put": {
        "tags": ["Organizaciones"], "summary": "Editar (si cambia el nombre, se actualiza en sus usuarios)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrganizacionEntrada" } } } },
        "responses": { "200": { "description": "Actualizada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Organizacion" } } } }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/organizaciones/{id}/estado": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "post": { "tags": ["Organizaciones"], "summary": "Activar o inactivar (alterna)", "responses": { "200": { "description": "Estado nuevo" } } }
    },
    "/tipos-operacion": {
      "get": {
        "tags": ["Catálogos"], "summary": "Listar tipos de operación",
        "parameters": [ { "name": "soloActivos", "in": "query", "schema": { "type": "boolean", "default": false } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogoItem" } } } } } }
      },
      "post": {
        "tags": ["Catálogos"], "summary": "Crear tipo de operación",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogoEntrada" } } } },
        "responses": { "201": { "description": "Creado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogoItem" } } } }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/tipos-operacion/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "put": { "tags": ["Catálogos"], "summary": "Editar tipo de operación", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogoEntrada" } } } }, "responses": { "200": { "description": "Actualizado" }, "409": { "$ref": "#/components/responses/Problema" } } },
      "delete": { "tags": ["Catálogos"], "summary": "Eliminar (solo si ninguna novedad lo usa y queda al menos un activo)", "responses": { "204": { "description": "Eliminado" }, "409": { "$ref": "#/components/responses/Problema" } } }
    },
    "/tipos-operacion/{id}/estado": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "post": { "tags": ["Catálogos"], "summary": "Activar o inactivar (alterna)", "responses": { "200": { "description": "Estado nuevo" }, "409": { "$ref": "#/components/responses/Problema" } } }
    },
    "/tipologias": {
      "get": {
        "tags": ["Catálogos"], "summary": "Listar tipologías",
        "parameters": [ { "name": "soloActivas", "in": "query", "schema": { "type": "boolean", "default": false } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogoItem" } } } } } }
      },
      "post": {
        "tags": ["Catálogos"], "summary": "Crear tipología",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogoEntrada" } } } },
        "responses": { "201": { "description": "Creada" }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/tipologias/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "put": { "tags": ["Catálogos"], "summary": "Editar (la sigla no cambia si está en uso)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogoEntrada" } } } }, "responses": { "200": { "description": "Actualizada" }, "409": { "$ref": "#/components/responses/Problema" } } },
      "delete": { "tags": ["Catálogos"], "summary": "Eliminar (solo si ningún tipo de novedad ni novedad la usa)", "responses": { "204": { "description": "Eliminada" }, "409": { "$ref": "#/components/responses/Problema" } } }
    },
    "/tipologias/{id}/estado": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "post": { "tags": ["Catálogos"], "summary": "Activar o inactivar (alterna)", "responses": { "200": { "description": "Estado nuevo" }, "409": { "$ref": "#/components/responses/Problema" } } }
    },
    "/causas": {
      "get": {
        "tags": ["Catálogos"], "summary": "Listar el catálogo de causas",
        "parameters": [ { "name": "soloActivas", "in": "query", "schema": { "type": "boolean", "default": false } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Causa" } } } } } }
      },
      "post": {
        "tags": ["Catálogos"], "summary": "Crear una causa (la edición en pantalla se decide más adelante; hoy se carga con la plantilla)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CausaEntrada" } } } },
        "responses": { "201": { "description": "Creada" }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/causas/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "put": { "tags": ["Catálogos"], "summary": "Editar una causa", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CausaEntrada" } } } }, "responses": { "200": { "description": "Actualizada" }, "409": { "$ref": "#/components/responses/Problema" } } }
    },
    "/causas/{id}/estado": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "post": { "tags": ["Catálogos"], "summary": "Activar o inactivar (alterna)", "responses": { "200": { "description": "Estado nuevo" } } }
    },
    "/tipos-novedad": {
      "get": {
        "tags": ["Tipos de novedad"], "summary": "Listar tipos de novedad",
        "description": "Para el formulario de registro: con tipologia y operacion se devuelven solo los tipos activos de esa tipología. Los reportantes solo reciben los que permiten reportar a su actor; administrador y torre reciben todos.",
        "parameters": [
          { "name": "tipologia", "in": "query", "schema": { "type": "string" } },
          { "name": "operacion", "in": "query", "schema": { "type": "string" } },
          { "name": "paraRegistrar", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TipoNovedad" } } } } } }
      },
      "post": {
        "tags": ["Tipos de novedad"], "summary": "Crear tipo de novedad",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TipoNovedad" } } } },
        "responses": { "201": { "description": "Creado" }, "400": { "$ref": "#/components/responses/Problema" }, "409": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/tipos-novedad/{titulo}": {
      "parameters": [ { "name": "titulo", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "get": { "tags": ["Tipos de novedad"], "summary": "Detalle de un tipo de novedad", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TipoNovedad" } } } }, "404": { "$ref": "#/components/responses/Problema" } } },
      "put": { "tags": ["Tipos de novedad"], "summary": "Editar tipo de novedad", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TipoNovedad" } } } }, "responses": { "200": { "description": "Actualizado" }, "400": { "$ref": "#/components/responses/Problema" } } },
      "delete": { "tags": ["Tipos de novedad"], "summary": "Eliminar", "responses": { "204": { "description": "Eliminado" } } }
    },
    "/tipos-novedad/{titulo}/estado": {
      "parameters": [ { "name": "titulo", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "post": { "tags": ["Tipos de novedad"], "summary": "Activar o inactivar (alterna)", "responses": { "200": { "description": "Estado nuevo" } } }
    },
    "/novedades": {
      "get": {
        "tags": ["Novedades"], "summary": "Listar novedades visibles para el usuario",
        "description": "La visibilidad se resuelve en el servidor: administrador y torre ven todas; gestor las dirigidas a su actor o a él y las que reportó; reportante las suyas.",
        "parameters": [
          { "name": "estado", "in": "query", "description": "activas (por defecto) | abierta | en_gestion | resuelta | reporte | todas", "schema": { "type": "string", "default": "activas" } },
          { "name": "estados", "in": "query", "description": "Selección múltiple de estados", "style": "form", "explode": true, "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EstadoNovedad" } } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "actor", "in": "query", "schema": { "type": "string" } },
          { "name": "tipologia", "in": "query", "schema": { "type": "string" } },
          { "name": "operacion", "in": "query", "schema": { "type": "string" } },
          { "name": "desde", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "hasta", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "orden", "in": "query", "schema": { "type": "string", "enum": ["id", "novedad", "actor", "organizacion", "estado", "fecha"], "default": "fecha" } },
          { "name": "dir", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } },
          { "$ref": "#/components/parameters/Pagina" }, { "$ref": "#/components/parameters/TamanoPagina" }
        ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaNovedades" } } } } }
      },
      "post": {
        "tags": ["Novedades"], "summary": "Registrar una novedad",
        "description": "Valida en el servidor: tipo/tipología/operación activos, permiso de reportar, descripción, destinatarios, información necesaria y datos terrestres obligatorios cuando el tipo los permite y algún destinatario (según el actor registrado) es OTT u OTT_TERCEROS. Operación atómica: novedad, destinatarios, datos, primer mensaje y notificaciones.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NovedadNueva" } } } },
        "responses": { "201": { "description": "Registrada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NovedadResumen" } } } }, "400": { "$ref": "#/components/responses/Problema" }, "403": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/novedades/{id}": {
      "parameters": [ { "$ref": "#/components/parameters/NovedadId" } ],
      "get": { "tags": ["Novedades"], "summary": "Detalle con hilo", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NovedadDetalle" } } } }, "403": { "$ref": "#/components/responses/Problema" }, "404": { "$ref": "#/components/responses/Problema" } } }
    },
    "/novedades/{id}/respuestas": {
      "parameters": [ { "$ref": "#/components/parameters/NovedadId" } ],
      "post": {
        "tags": ["Novedades"], "summary": "Responder (administrador, torre o gestor cuyo actor es respondente). Una novedad abierta pasa a en_gestion",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MensajeEntrada" } } } },
        "responses": { "201": { "description": "Registrada" }, "403": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/novedades/{id}/replicas": {
      "parameters": [ { "$ref": "#/components/parameters/NovedadId" } ],
      "post": {
        "tags": ["Novedades"], "summary": "Replicar (solo el reportante)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MensajeEntrada" } } } },
        "responses": { "201": { "description": "Registrada" }, "403": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/novedades/{id}/resolucion": {
      "parameters": [ { "$ref": "#/components/parameters/NovedadId" } ],
      "post": {
        "tags": ["Novedades"], "summary": "Resolver (guarda quién y cuándo; notifica el cierre)",
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MensajeEntrada" } } } },
        "responses": { "200": { "description": "Resuelta" }, "403": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/novedades/{id}/adjuntos": {
      "parameters": [ { "$ref": "#/components/parameters/NovedadId" } ],
      "post": {
        "tags": ["Novedades"], "summary": "Adjuntar un archivo a la novedad (se guarda en Azure Blob Storage, contenedor privado)",
        "description": "Valida tipo y tamaño. Valores propuestos pendientes de confirmar: JPG, PNG, PDF, Excel y Word; máximo 10 MB por archivo y 5 por mensaje. Pueden verlo solo quienes pueden ver la novedad.",
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["archivo"], "properties": { "archivo": { "type": "string", "format": "binary" }, "mensajeId": { "type": "integer", "nullable": true, "description": "Si se envía, el archivo queda asociado a ese mensaje del hilo" } } } } } },
        "responses": { "201": { "description": "Adjuntado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Adjunto" } } } }, "400": { "$ref": "#/components/responses/Problema" }, "403": { "$ref": "#/components/responses/Problema" }, "413": { "description": "Archivo demasiado grande" }, "415": { "description": "Tipo de archivo no permitido" } }
      },
      "get": {
        "tags": ["Novedades"], "summary": "Listar los adjuntos de la novedad",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Adjunto" } } } } }, "403": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/adjuntos/{adjuntoId}": {
      "parameters": [ { "name": "adjuntoId", "in": "path", "required": true, "schema": { "type": "integer" } } ],
      "get": {
        "tags": ["Novedades"], "summary": "Descargar un adjunto (la API entrega el archivo o una URL SAS de vida corta)",
        "responses": { "200": { "description": "Archivo", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "403": { "$ref": "#/components/responses/Problema" }, "404": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/novedades/exportacion": {
      "get": {
        "tags": ["Novedades"], "summary": "Exportar a Excel/CSV con los mismos filtros que el listado",
        "description": "Cualquier usuario autenticado puede exportar, limitado a las novedades que puede ver: reportante y gestor solo las suyas; administrador y torre de control todas.",
        "parameters": [ { "name": "formato", "in": "query", "schema": { "type": "string", "enum": ["xlsx", "csv"], "default": "xlsx" } } ],
        "responses": { "200": { "description": "Archivo", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "401": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/notificaciones": {
      "get": { "tags": ["Notificaciones"], "summary": "Notificaciones del usuario actual", "parameters": [ { "name": "soloNoLeidas", "in": "query", "schema": { "type": "boolean" } } ], "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "noLeidas": { "type": "integer" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/Notificacion" } } } } } } } } },
      "delete": { "tags": ["Notificaciones"], "summary": "Limpiar todas las notificaciones propias", "responses": { "204": { "description": "Eliminadas" } } }
    },
    "/notificaciones/leidas": {
      "post": { "tags": ["Notificaciones"], "summary": "Marcar todas como leídas", "responses": { "204": { "description": "OK" } } }
    },
    "/notificaciones/{novedadId}": {
      "parameters": [ { "name": "novedadId", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "post": { "tags": ["Notificaciones"], "summary": "Alternar leída / no leída", "responses": { "200": { "description": "Estado nuevo" } } },
      "delete": { "tags": ["Notificaciones"], "summary": "Eliminar una notificación", "responses": { "204": { "description": "Eliminada" } } }
    },
    "/configuracion/politicas": {
      "get": {
        "tags": ["Salud"], "summary": "Parámetros vigentes que el cliente necesita para validar (contraseñas, adjuntos, estado del correo)",
        "description": "Los valores se fijan en la migración y viven en la configuración del API (tabla Configuracion). El Web Site los lee de aquí y no los duplica.",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Politicas" } } } }, "401": { "$ref": "#/components/responses/Problema" } }
      }
    },
    "/health": {
      "get": { "tags": ["Salud"], "summary": "Liveness", "security": [], "responses": { "200": { "description": "OK" } } }
    },
    "/health/ready": {
      "get": { "tags": ["Salud"], "summary": "Readiness (incluye Azure SQL)", "security": [], "responses": { "200": { "description": "Lista" }, "503": { "description": "Dependencia no disponible" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "parameters": {
      "UsuarioPath": { "name": "usuario", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[a-z0-9._-]{3,30}$" } },
      "NovedadId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^NOV-\\d{8}-\\d{3,}$" } },
      "Pagina": { "name": "pagina", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "TamanoPagina": { "name": "tamano", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } }
    },
    "responses": {
      "Problema": { "description": "Error", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problema" } } } }
    },
    "schemas": {
      "Problema": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string", "description": "Mensaje entendible y accionable, en español" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "traceId": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      },
      "Politicas": {
        "type": "object",
        "properties": {
          "password": { "type": "object", "properties": { "largoMinimo": { "type": "integer", "example": 6 }, "complejidad": { "type": "string" }, "caducidadDias": { "type": "integer", "nullable": true }, "maxIntentos": { "type": "integer" }, "bloqueoMinutos": { "type": "integer" }, "recuperacionHabilitada": { "type": "boolean" } } },
          "adjuntos": { "type": "object", "properties": { "tiposPermitidos": { "type": "array", "items": { "type": "string" }, "example": ["jpg", "png", "pdf", "xlsx", "docx"] }, "tamanoMaxMb": { "type": "integer", "example": 10 }, "maxPorMensaje": { "type": "integer", "example": 5 }, "retencionDias": { "type": "integer", "nullable": true } } },
          "correo": { "type": "object", "properties": { "habilitado": { "type": "boolean", "example": false } } }
        }
      },
      "Permiso": { "type": "string", "enum": ["administrador", "torre_control", "gestor", "reportante"] },
      "EstadoNovedad": { "type": "string", "enum": ["abierta", "en_gestion", "resuelta", "reporte"] },
      "TipoMensaje": { "type": "string", "enum": ["reporte", "respuesta", "replica", "cierre"] },
      "LoginRequest": { "type": "object", "required": ["usuario", "password"], "properties": { "usuario": { "type": "string" }, "password": { "type": "string", "format": "password" } } },
      "SesionUsuario": {
        "type": "object",
        "properties": {
          "usuario": { "type": "string" }, "nombre": { "type": "string" },
          "permiso": { "$ref": "#/components/schemas/Permiso" },
          "puedeParametrizar": { "type": "boolean" },
          "tipoActor": { "type": "string" }, "organizacion": { "type": "string" },
          "token": { "type": "string" }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "usuario": { "type": "string" }, "nombre": { "type": "string" },
          "rolOrganizacional": { "type": "string", "description": "Cargo real en la empresa" },
          "permiso": { "$ref": "#/components/schemas/Permiso" },
          "puedeParametrizar": { "type": "boolean", "description": "Solo aplica a torre_control" },
          "tipoActor": { "type": "string" }, "organizacionId": { "type": "integer", "nullable": true }, "organizacion": { "type": "string" },
          "activo": { "type": "boolean" }, "fechaCreacion": { "type": "string", "format": "date-time" }
        }
      },
      "UsuarioNuevo": {
        "allOf": [
          { "$ref": "#/components/schemas/UsuarioEdicion" },
          { "type": "object", "required": ["usuario", "password"], "properties": { "usuario": { "type": "string", "pattern": "^[a-z0-9._-]{3,30}$" }, "password": { "type": "string", "minLength": 6, "maxLength": 72, "format": "password" } } }
        ]
      },
      "UsuarioEdicion": {
        "type": "object",
        "required": ["nombre", "permiso", "tipoActor", "organizacionId"],
        "properties": {
          "usuario": { "type": "string", "description": "Nuevo nombre de usuario; se rechaza si tiene historial" },
          "nombre": { "type": "string", "minLength": 3, "maxLength": 80 },
          "rolOrganizacional": { "type": "string", "maxLength": 80 },
          "permiso": { "$ref": "#/components/schemas/Permiso" },
          "puedeParametrizar": { "type": "boolean" },
          "tipoActor": { "type": "string" },
          "organizacionId": { "type": "integer" }
        }
      },
      "Organizacion": { "type": "object", "properties": { "id": { "type": "integer" }, "tipoActor": { "type": "string" }, "nombre": { "type": "string" }, "ubicacion": { "type": "string" }, "activo": { "type": "boolean" }, "usuarios": { "type": "integer" } } },
      "OrganizacionEntrada": { "type": "object", "required": ["tipoActor", "nombre"], "properties": { "tipoActor": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,30}$" }, "nombre": { "type": "string", "minLength": 2, "maxLength": 100 }, "ubicacion": { "type": "string", "maxLength": 60 } } },
      "PaginaOrganizaciones": { "type": "object", "properties": { "total": { "type": "integer" }, "pagina": { "type": "integer" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/Organizacion" } } } },
      "CatalogoItem": { "type": "object", "properties": { "id": { "type": "integer" }, "codigo": { "type": "string" }, "clave": { "type": "string", "description": "Solo tipos de operación; identificador estable" }, "nombre": { "type": "string" }, "descripcion": { "type": "string" }, "estado": { "type": "integer", "enum": [0, 1] }, "enUso": { "type": "integer" } } },
      "Causa": { "type": "object", "properties": { "id": { "type": "integer" }, "nombre": { "type": "string" }, "descripcion": { "type": "string" }, "activo": { "type": "boolean" } } },
      "CausaEntrada": { "type": "object", "required": ["nombre"], "properties": { "nombre": { "type": "string", "maxLength": 120 }, "descripcion": { "type": "string", "maxLength": 300 }, "activo": { "type": "boolean", "default": true } } },
      "CatalogoEntrada": { "type": "object", "required": ["codigo", "nombre"], "properties": { "codigo": { "type": "string", "pattern": "^[A-Z0-9_]{2,10}$" }, "nombre": { "type": "string", "minLength": 3, "maxLength": 60 }, "descripcion": { "type": "string", "maxLength": 300 }, "estado": { "type": "integer", "enum": [0, 1], "default": 1 } } },
      "TipoNovedad": {
        "type": "object",
        "required": ["titulo", "tiposOperacion", "tipologia", "actoresReportantes", "actoresRespondentes"],
        "properties": {
          "titulo": { "type": "string", "example": "ACCIDENTE_DE_TRABAJO" },
          "eje": { "type": "string" }, "tipo": { "type": "string" }, "subtipo": { "type": "string" },
          "descripcion": { "type": "string" },
          "tiposOperacion": { "type": "array", "items": { "type": "string" }, "description": "Claves de operación" },
          "tipologia": { "type": "string", "description": "Una sola tipología (código)" },
          "actoresReportantes": { "type": "array", "items": { "type": "string" } },
          "actoresRespondentes": { "type": "array", "items": { "type": "string" } },
          "actoresEtiquetables": { "type": "array", "items": { "type": "string" } },
          "notificarAdmin": { "type": "boolean" }, "notificarTorre": { "type": "boolean" },
          "requiereRespuesta": { "type": "boolean" }, "requiereAdjunto": { "type": "boolean" },
          "involucraTerrestre": { "type": "boolean" }, "involucraVuelo": { "type": "boolean" }, "involucraTiempos": { "type": "boolean" },
          "causas": { "type": "array", "items": { "type": "string" }, "description": "Nombres de causas del catálogo (/causas) que aplican a este tipo, en orden" },
          "camposGrupo": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "Por grupo (terrestre, aereo, tiempos): campos que se piden" },
          "infoNecesaria": { "type": "array", "items": { "type": "object", "properties": { "nombre": { "type": "string" }, "tipo": { "type": "string" } } } },
          "camposPersonalizados": { "type": "array", "items": { "type": "object", "properties": { "nombre": { "type": "string" }, "tipo": { "type": "string" }, "requerido": { "type": "boolean" } } } },
          "activo": { "type": "boolean" }
        }
      },
      "Destinatario": {
        "type": "object",
        "properties": {
          "usuario": { "type": "string", "nullable": true },
          "correo": { "type": "string", "format": "email", "nullable": true },
          "principal": { "type": "boolean" }, "externo": { "type": "boolean" }
        }
      },
      "NovedadNueva": {
        "type": "object",
        "required": ["tipoNovedad", "tipologia", "tipoOperacion", "descripcion", "destinatarios"],
        "properties": {
          "tipoNovedad": { "type": "string" },
          "tipologia": { "type": "string", "description": "Una de las tipologías del tipo; queda como principal" },
          "tipoOperacion": { "type": "string", "description": "Clave de un tipo de operación activo" },
          "descripcion": { "type": "string" },
          "causal": { "type": "string", "nullable": true },
          "expId": { "type": "string", "nullable": true },
          "fechaDespacho": { "type": "string", "format": "date", "nullable": true },
          "horaDespacho": { "type": "string", "format": "time", "nullable": true },
          "destinatarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/Destinatario" }, "description": "Debe incluir un destinatario principal; el actor de cada usuario se toma del registro, no del cliente" },
          "datos": { "type": "object", "additionalProperties": true, "description": "Datos del evento por grupo: terrestre, aereo, tiempos, personalizados" },
          "copiaCorreo": { "type": "array", "items": { "type": "string", "format": "email" }, "deprecated": true, "description": "Diferido (CL-003): se ignora hasta que se conecte una API de correo" }
        }
      },
      "NovedadResumen": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "tipoNovedad": { "type": "string" },
          "tipologia": { "type": "string" },
          "tipoOperacion": { "type": "string" }, "estado": { "$ref": "#/components/schemas/EstadoNovedad" },
          "tipoActorReportante": { "type": "string" }, "organizacion": { "type": "string" },
          "fechaCreacion": { "type": "string", "format": "date-time" },
          "diasAbierta": { "type": "integer", "nullable": true }
        }
      },
      "NovedadDetalle": {
        "allOf": [
          { "$ref": "#/components/schemas/NovedadResumen" },
          {
            "type": "object",
            "properties": {
              "usuarioReportante": { "type": "string" }, "causal": { "type": "string", "nullable": true },
              "fechaDespacho": { "type": "string", "format": "date", "nullable": true },
              "datos": { "type": "object", "additionalProperties": true },
              "destinatarios": { "type": "array", "items": { "$ref": "#/components/schemas/Destinatario" } },
              "hilo": { "type": "array", "items": { "$ref": "#/components/schemas/Mensaje" } },
              "resueltoPor": { "type": "string", "nullable": true }, "fechaResolucion": { "type": "string", "format": "date-time", "nullable": true }
            }
          }
        ]
      },
      "PaginaNovedades": { "type": "object", "properties": { "total": { "type": "integer" }, "pagina": { "type": "integer" }, "contadores": { "type": "object", "properties": { "abierta": { "type": "integer" }, "en_gestion": { "type": "integer" }, "reporte": { "type": "integer" }, "resuelta": { "type": "integer" }, "total": { "type": "integer" } } }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/NovedadResumen" } } } },
      "Adjunto": { "type": "object", "properties": { "id": { "type": "integer" }, "nombreArchivo": { "type": "string" }, "tipoMime": { "type": "string" }, "tamanoBytes": { "type": "integer", "format": "int64" }, "mensajeId": { "type": "integer", "nullable": true } } },
      "Mensaje": { "type": "object", "properties": { "autor": { "type": "string" }, "nombre": { "type": "string" }, "tipo": { "$ref": "#/components/schemas/TipoMensaje" }, "mensaje": { "type": "string" }, "fecha": { "type": "string", "format": "date-time" } } },
      "MensajeEntrada": { "type": "object", "required": ["mensaje"], "properties": { "mensaje": { "type": "string", "minLength": 1 } } },
      "Notificacion": { "type": "object", "properties": { "novedadId": { "type": "string" }, "tipoNovedad": { "type": "string" }, "organizacion": { "type": "string" }, "fecha": { "type": "string", "format": "date-time" }, "leida": { "type": "boolean" } } }
    }
  }
}
